# Copy this file to ".env" and adjust the values, then run: docker compose up -d

# External port to reach the app (http://<server-ip>:<APP_PORT>)
APP_PORT=8080

# Prebuilt image to pull. Leave as-is to build locally, or set to your GitHub
# Container Registry image to pull instead of building, e.g.:
#   APP_IMAGE=ghcr.io/your-github-username/alfathpulsa:latest
APP_IMAGE=alfathpulsa:latest

# Database credentials (shared by the db container and the app)
POSTGRES_USER=alfath
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=alfathpulsa

# Secret that keeps login sessions valid. Use a long random string.
# IMPORTANT: keep this the SAME forever — changing it logs everyone out.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-this-to-a-long-random-string

# Optional: WhatsApp notifications via Fonnte. Leave blank to disable.
FONNTE_API_KEY=
